load_lib "standard.exp"

# Avoid multitop on Darwin, where it's at best useless, and attempts to
# determine it may cause failures with the use of the -dumpspecs option.
if { [istarget "*-*-darwin*"] } {
    set_board_info multitop ""
}

# Provide a way to pass the host architecture to the compiler, which
# doesn't happen automatically.
#
if [info exists env(HOSTARCH)] {
  set_board_info cflags "-arch ${env(HOSTARCH)}"
  set_board_info cxxflags "-arch ${env(HOSTARCH)}"
}
